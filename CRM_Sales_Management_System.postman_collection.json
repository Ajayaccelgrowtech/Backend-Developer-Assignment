							"mode": "raw",
							"raw": "{\n  \"name\": \"David Miller\",\n  \"email\": \"david.miller@crm.com\",\n  \"phone\": \"+1-555-7766\",\n  \"password\": \"ExecPass123!\",\n  \"role\": \"Sales Executive\",\n  \"isActive\": true\n}"
